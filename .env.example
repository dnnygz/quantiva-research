# Copy to .env and replace the placeholders with local-only values.
POSTGRES_USER=qa
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_DB=quantum_aware
DATABASE_URL=postgres://qa:choose-a-local-password@127.0.0.1:5433/quantum_aware

# Optional. If omitted, admin:create prompts without echoing the password.
# ADMIN_PASSWORD=choose-a-long-admin-password
